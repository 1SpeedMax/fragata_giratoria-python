# Configuración para desarrollo local o Railway
# NO subas este archivo con tus credenciales reales.

DATABASE_URL=postgres://usuario:password@host:5432/nombre_bd
RAILWAY_ENVIRONMENT=production
RAILWAY_PUBLIC_DOMAIN=tu-app-production.up.railway.app
SITE_URL=https://tu-app-production.up.railway.app

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=tu_contraseña_de_aplicación
DEFAULT_FROM_EMAIL=tu_correo@gmail.com
CONTACT_EMAIL_RECIPIENT=tu_correo_de_contacto@dominio.com

# Opcional: orígenes permitidos extra para CSRF
CSRF_TRUSTED_ORIGINS=https://tu-app-production.up.railway.app
